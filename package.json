{
  "name": "transfer",
  "version": "1.2.1",
  "description": "跨平台局域网工具:文件传送 + 截屏 + 笔记(MVP:文件传送)",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "NODE_OPTIONS=\"--experimental-sqlite --no-warnings\" vitest run",
    "test:watch": "NODE_OPTIONS=\"--experimental-sqlite --no-warnings\" vitest",
    "e2e": "electron-vite build && playwright test",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never -c.mac.notarize=false",
    "dist:mac:package-signed": "electron-vite build && electron-builder --mac --publish never",
    "notarize:mac:dmgs": "node build/notarize-dmgs.cjs release/*/*.dmg",
    "dist:mac:sign": "pnpm run dist:mac:package-signed && pnpm run notarize:mac:dmgs",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mas:dev": "electron-vite build && electron-builder --mac mas-dev --publish never",
    "dist:mas": "electron-vite build && electron-builder --mac mas --universal --publish never",
    "pkg:mas": "node build/make-mas-pkg.cjs",
    "deploy:site:cn": "bash build/deploy-site-cn.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^5.5.0"
  }
}
